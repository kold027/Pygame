import pygame

pygame.init()
screen = pygame.display.set_mode((400, 400))

# make a surface with a rectangle on it
rect_surf = pygame.Surface((100, 100), pygame.SRCALPHA)  
pygame.draw.rect(rect_surf, (255, 0, 0), rect_surf.get_rect())

# rotate it 45 degrees once
rotated_surf = pygame.transform.rotate(rect_surf, 45)
rotated_rect = rotated_surf.get_rect(center=(200, 200))  # put it in the middle

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill((30, 30, 30))
    screen.blit(rotated_surf, rotated_rect)
    pygame.display.flip()

pygame.quit()
