from flask import Flask, render_template, request, redirect, url_for
from threading import Timer

app = Flask(__name__)

# Game state
players = {}
choices = {}
game_active = False
results_ready = False

@app.route("/")
def index():
    return render_template("index.html")

@app.route("/join", methods=["POST"])
def join():
    username = request.form["username"]
    if username not in players:
        players[username] = None
    return redirect(url_for("play", username=username))

@app.route("/play/<username>")
def play(username):
    if results_ready:
        return redirect(url_for("results"))
    return render_template("play.html", username=username, game_active=game_active)

@app.route("/choose/<username>", methods=["POST"])
def choose(username):
    choice = request.form["choice"]
    players[username] = choice
    return redirect(url_for("play", username=username))

@app.route("/host")
def host():
    global game_active, results_ready
    return render_template("host.html", players=players, game_active=game_active, results_ready=results_ready)

@app.route("/start", methods=["POST"])
def start():
    global game_active, results_ready
    game_active = True
    results_ready = False
    Timer(30.0, end_game).start()
    return redirect(url_for("host"))

def end_game():
    global game_active, results_ready, choices
    game_active = False
    results_ready = True
    choices = players.copy()

@app.route("/results")
def results():
    return render_template("results.html", choices=choices)

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
